page { background:#f5f7fa; }.page { min-height:100vh; padding:24rpx; box-sizing:border-box; }.hero { display:flex; justify-content:space-between; align-items:center; padding:30rpx; border-radius:20rpx; color:#fff; background:linear-gradient(135deg,#20B8AA,#20B8AA); }.hero-title { display:block; font-size:36rpx; font-weight:600; }.hero-desc { display:block; max-width:390rpx; margin-top:10rpx; font-size:22rpx; opacity:.9; }.create-btn { margin:0; padding:0 22rpx; height:66rpx; line-height:66rpx; border-radius:34rpx; color:#20B8AA; background:#fff; font-size:24rpx; }.create-btn::after,button::after { border:0; }.empty { padding-top:220rpx; display:flex; flex-direction:column; align-items:center; color:#8a9099; }.empty-icon { color:#20B8AA; font-size:90rpx; }.empty-title { margin-top:16rpx; color:#35445a; font-size:30rpx; }.empty-desc { margin-top:12rpx; font-size:24rpx; }.message-list { height:calc(100vh - 210rpx); margin-top:20rpx; }.message-card { margin-bottom:18rpx; padding:26rpx; border-radius:18rpx; background:#fff; box-shadow:0 2rpx 10rpx rgba(31,35,41,.04); }.message-head { display:flex; justify-content:space-between; align-items:center; }.message-time { color:#526174; font-size:24rpx; }.status { padding:6rpx 14rpx; border-radius:20rpx; color:#8791a0; background:#f0f2f5; font-size:21rpx; }.status.ready { color:#20B8AA; background:#F0F8F7; }.message-content { display:block; margin-top:20rpx; color:#263448; font-size:27rpx; line-height:1.6; white-space:pre-wrap; }.message-actions { display:flex; gap:16rpx; margin-top:20rpx; }.message-actions button { flex:1; height:66rpx; line-height:66rpx; margin:0; border-radius:10rpx; color:#20B8AA; background:#F0F8F7; font-size:23rpx; }.message-actions .delete { color:#168F86; background:#F0F8F7; }.mask { position:fixed; z-index:10; inset:0; display:flex; align-items:flex-end; background:rgba(16,27,42,.42); }.sheet { width:100%; padding:30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); box-sizing:border-box; border-radius:20rpx 20rpx 0 0; background:#fff; }.sheet-title { display:block; margin-bottom:22rpx; color:#1f2329; text-align:center; font-size:31rpx; font-weight:600; }.textarea { width:100%; height:150rpx; padding:20rpx; box-sizing:border-box; border:1rpx solid #e4e8ee; border-radius:12rpx; font-size:26rpx; }.label { display:block; margin-top:18rpx; color:#687586; font-size:23rpx; }.picker { height:76rpx; line-height:76rpx; margin-top:10rpx; padding:0 20rpx; border-radius:12rpx; color:#35445a; background:#f3f5f7; font-size:26rpx; }.sheet-actions { display:flex; gap:16rpx; margin-top:26rpx; }.sheet-actions button { flex:1; height:78rpx; line-height:78rpx; border-radius:12rpx; color:#687586; background:#f3f5f7; font-size:26rpx; }.sheet-actions .primary { color:#fff; background:#20B8AA; }
button { display:flex; align-items:center; justify-content:center; text-align:center; box-sizing:border-box; }
