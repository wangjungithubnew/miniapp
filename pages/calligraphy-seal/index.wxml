<view class="page"><view class="preview"><canvas type="2d" id="sealCanvas" class="canvas"></canvas></view><view class="panel"><input class="input" maxlength="4" value="{{text}}" placeholder="输入 1-4 个印章文字" bindinput="onInput"/><text class="label">印面形状</text><view class="options"><view class="option {{shape === 'square' ? 'selected' : ''}}" data-key="shape" data-value="square" bindtap="choose">方形</view><view class="option {{shape === 'circle' ? 'selected' : ''}}" data-key="shape" data-value="circle" bindtap="choose">圆形</view></view><text class="label">印文效果</text><view class="options"><view class="option {{mode === 'red' ? 'selected' : ''}}" data-key="mode" data-value="red" bindtap="choose">朱文</view><view class="option {{mode === 'white' ? 'selected' : ''}}" data-key="mode" data-value="white" bindtap="choose">白文</view></view><button class="primary" bindtap="save">保存书法印章</button><button class="secondary" wx:if="{{savedPath}}" bindtap="saveAlbum">保存到相册</button></view></view>
