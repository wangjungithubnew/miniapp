page { background:#f5f7fa; }.page { min-height:100vh; padding:32rpx 28rpx; box-sizing:border-box; }.card { padding:42rpx 28rpx; border-radius:16rpx; background:#fff; text-align:center; }.logo { width:112rpx; height:112rpx; margin:0 auto; display:flex; align-items:center; justify-content:center; border-radius:24rpx; background:#20B8AA; color:#fff; font-size:54rpx; }.name { display:block; margin-top:24rpx; color:#263238; font-size:32rpx; font-weight:600; }.desc { display:block; margin-top:18rpx; color:#687586; font-size:24rpx; line-height:1.6; }.details { margin-top:22rpx; padding:0 28rpx; text-align:left; }.row { min-height:100rpx; display:flex; align-items:center; justify-content:space-between; border-bottom:1rpx solid #edf0f2; color:#687586; font-size:25rpx; }.row:last-child { border-bottom:0; }
