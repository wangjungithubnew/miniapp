page { background:#f5f7fa; }.page { min-height:100vh; padding:32rpx 28rpx; box-sizing:border-box; }.group { margin-bottom:24rpx; overflow:hidden; border-radius:16rpx; background:#fff; box-shadow:0 2rpx 12rpx rgba(31,35,41,.04); }.row { width:100%; min-height:104rpx; margin:0; padding:0 28rpx; box-sizing:border-box; display:flex; align-items:center; justify-content:space-between; border-bottom:1rpx solid #edf0f2; color:#263238; font-size:28rpx; }.row:last-child { border-bottom:0; }.arrow { color:#a4adb5; font-size:40rpx; font-weight:300; }.contact-row { width:100%; padding:0 28rpx; margin:0; background:#fff; text-align:left; border-radius:0; font-weight:400; }.contact-row::after { border:0; }
/* 在线客服按钮与普通列表行保持完全一致的右侧对齐。 */
.contact-row { width:100%; height:104rpx; padding:0 28rpx; margin:0; box-sizing:border-box; display:flex; align-items:center; justify-content:space-between; background:#fff; text-align:left; border-radius:0; font-weight:400; }
.contact-row::after { border:0; }
