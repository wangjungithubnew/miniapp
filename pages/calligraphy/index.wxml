<view class="page"><view class="preview"><canvas type="2d" id="calligraphyCanvas" class="canvas"></canvas></view><view class="panel"><input class="input" maxlength="20" placeholder="输入汉字或诗句" value="{{text}}" bindinput="onInput"/><text class="label">字体风格</text><view class="styles"><view wx:for="{{styles}}" wx:key="*this" class="style {{styleIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="chooseStyle">{{item}}</view></view><view class="size-row"><text>字号</text><slider min="46" max="110" step="2" value="{{size}}" bindchange="changeSize" show-value /></view><view class="switch-row"><text>显示米字格</text><switch checked="{{grid}}" color="#20B8AA" bindchange="toggleGrid" /></view><button class="primary" bindtap="save">保存书法作品</button><button class="secondary" wx:if="{{savedPath}}" bindtap="saveAlbum">保存到相册</button></view></view>
