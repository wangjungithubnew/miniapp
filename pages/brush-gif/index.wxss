page { background:#f5f7fa; }.page { min-height:100vh; padding:24rpx; box-sizing:border-box; }.preview { height:560rpx; position:relative; overflow:hidden; border-radius:18rpx; background:#fff; box-shadow:0 2rpx 10rpx rgba(31,35,41,.05); }.canvas { width:100%; height:100%; }.hint { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:#a1aab6; font-size:27rpx; pointer-events:none; }.panel { margin-top:20rpx; padding:26rpx; border-radius:18rpx; background:#fff; }.label { display:block; color:#687586; font-size:23rpx; }.colors { display:flex; gap:18rpx; margin-top:14rpx; }.color { width:54rpx; height:54rpx; border-radius:50%; border:5rpx solid #fff; box-shadow:0 0 0 1rpx #d9dee6; }.color.selected { box-shadow:0 0 0 4rpx #edabb2; }.size-row { display:flex; align-items:center; margin-top:20rpx; color:#687586; font-size:24rpx; }.size-row slider { flex:1; margin-left:20rpx; }.actions { display:flex; gap:18rpx; margin-top:20rpx; }.actions button,.primary,.secondary { flex:1; height:80rpx; line-height:80rpx; margin:0; border-radius:12rpx; font-size:26rpx; }.actions button::after,.primary::after,.secondary::after { border:0; }.play { color:#fff; background:#d95778; }.actions button:not(.play) { color:#687586; background:#f3f5f7; }.primary { width:100%; margin-top:20rpx; color:#fff; background:#d95778; }.secondary { width:100%; margin-top:16rpx; color:#d95778; background:#fff0f4; }.note { display:block; margin-top:18rpx; color:#a0a9b5; text-align:center; font-size:20rpx; }
button { display:flex; align-items:center; justify-content:center; text-align:center; box-sizing:border-box; }
