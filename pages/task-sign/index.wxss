page { background: #f5f7fa; } .page { min-height: 100vh; box-sizing: border-box; padding: 28rpx; } .hero { display:flex; justify-content:space-between; align-items:center; padding:30rpx; border-radius:20rpx; color:#fff; background:linear-gradient(135deg,#d95778,#e67f98); }.hero-title,.hero-desc,.task-title,.task-time,.task-desc,.member-time { display:block; }.hero-title { font-size:38rpx; font-weight:600; }.hero-desc { margin-top:10rpx; font-size:23rpx; opacity:.88; }.create-btn { margin:0; padding:0 24rpx; height:66rpx; line-height:66rpx; color:#d95778; background:#fff; border-radius:34rpx; font-size:25rpx; }.create-btn::after,button::after { border:0; }.empty { padding-top:220rpx; display:flex; flex-direction:column; align-items:center; color:#8a9099; }.empty-icon { color:#e3a2b2; font-size:90rpx; }.empty-title { margin-top:16rpx; color:#35445a; font-size:30rpx; }.empty-desc { margin-top:12rpx; font-size:24rpx; }.task-list { height:calc(100vh - 210rpx); margin-top:20rpx; }.task-card { margin-bottom:20rpx; padding:26rpx; border-radius:18rpx; background:#fff; box-shadow:0 2rpx 10rpx rgba(31,35,41,.04); }.task-card.active { outline:2rpx solid #e8a5b5; }.task-head { display:flex; align-items:flex-start; }.task-title { color:#1f2329; font-size:30rpx; font-weight:600; }.task-time { margin-top:8rpx; color:#929eac; font-size:21rpx; }.delete { margin-left:auto; color:#d95778; font-size:23rpx; }.task-desc { margin-top:18rpx; color:#5f6b7a; font-size:25rpx; line-height:1.55; }.progress-row { display:flex; justify-content:space-between; margin-top:20rpx; color:#7e8997; font-size:22rpx; }.member-list { margin-top:12rpx; border-top:1rpx solid #f0f1f3; }.member { display:flex; align-items:center; min-height:62rpx; color:#425066; font-size:24rpx; border-bottom:1rpx solid #f5f6f8; }.member-dot { width:38rpx; color:#b5bdc7; }.member-dot.done { color:#16835e; }.member-time { margin-left:auto; color:#9ba4b0; font-size:20rpx; }.sign-btn { width:100%; margin-top:20rpx; height:72rpx; line-height:72rpx; border-radius:12rpx; color:#fff; background:#d95778; font-size:26rpx; }.mask { position:fixed; z-index:10; inset:0; display:flex; align-items:flex-end; background:rgba(16,27,42,.42); }.sheet { width:100%; padding:30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom)); box-sizing:border-box; border-radius:20rpx 20rpx 0 0; background:#fff; }.sheet-title { display:block; margin-bottom:24rpx; color:#1f2329; text-align:center; font-size:31rpx; font-weight:600; }.sign-tip { display:block; margin:-6rpx 0 22rpx; color:#8a9099; font-size:23rpx; text-align:center; }.input,.textarea { box-sizing:border-box; width:100%; margin-top:16rpx; padding:20rpx; border:1rpx solid #e6e9ed; border-radius:12rpx; color:#1f2329; font-size:26rpx; }.input { height:84rpx; }.textarea { height:130rpx; }.sheet-actions { display:flex; gap:18rpx; margin-top:26rpx; }.sheet-actions button { flex:1; height:78rpx; line-height:78rpx; border-radius:12rpx; color:#657182; background:#f3f5f7; font-size:27rpx; }.sheet-actions .primary { color:#fff; background:#d95778; }
