page { background:#f5f7fa; }.page { min-height:100vh; padding:24rpx; box-sizing:border-box; }.preview { height:520rpx; overflow:hidden; border-radius:18rpx; background:#fffaf0; box-shadow:0 2rpx 10rpx rgba(31,35,41,.05); }.canvas { width:100%; height:100%; }.panel { margin-top:20rpx; padding:26rpx; border-radius:18rpx; background:#fff; }.input { width:100%; height:84rpx; padding:0 22rpx; box-sizing:border-box; border:1rpx solid #e4e8ee; border-radius:12rpx; font-size:28rpx; }.label { display:block; margin-top:24rpx; color:#687586; font-size:23rpx; }.options { display:flex; gap:16rpx; margin-top:14rpx; }.option { padding:16rpx 30rpx; border-radius:12rpx; color:#687586; background:#f3f5f7; font-size:25rpx; }.option.selected { color:#b63b45; background:#fff0f1; outline:2rpx solid #edabb2; }.primary,.secondary { width:100%; height:82rpx; line-height:82rpx; margin-top:28rpx; border-radius:12rpx; font-size:27rpx; }.primary { color:#fff; background:#b63b45; }.secondary { margin-top:16rpx; color:#b63b45; background:#fff0f1; }.primary::after,.secondary::after { border:0; }
button { display:flex; align-items:center; justify-content:center; text-align:center; box-sizing:border-box; }
