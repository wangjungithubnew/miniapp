.card { position: relative; height: 190rpx; padding: 22rpx 24rpx; box-sizing: border-box; background: #FFFFFF; border-radius: 16rpx; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; box-shadow: 0 1px 2px rgba(31,35,41,.04); }
.card-hover { background: #FFF1F4; transform: scale(.99); }
.icon-box { position: absolute; right: 22rpx; bottom: 20rpx; width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; color: #D95778; }
.icon { width: 62rpx; height: 62rpx; }
.title { color: #1F2329; font-size: 31rpx; font-weight: 500; max-width: 74%; }
.description { margin-top: 10rpx; max-width: 76%; color: #8A9099; font-size: 22rpx; line-height: 1.35; }
.tone-0 { background: #EAF4FF; }.tone-1 { background: #EDF8F0; }.tone-2 { background: #FFF5E5; }.tone-3 { background: #F9EEFA; }
