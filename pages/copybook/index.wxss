page { background:#f5f7fa; }.page { min-height:100vh; padding:24rpx; box-sizing:border-box; }.tip { color:#687586; font-size:24rpx; text-align:center; }.char-list { margin-top:20rpx; white-space:nowrap; }.char { display:inline-flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; margin-right:14rpx; border-radius:14rpx; color:#536176; background:#fff; font-size:36rpx; }.char.selected { color:#b45b4e; background:#fff0eb; outline:2rpx solid #d99486; }.board { height:650rpx; margin-top:20rpx; overflow:hidden; border-radius:18rpx; background:#fffaf0; box-shadow:0 2rpx 10rpx rgba(31,35,41,.05); }.canvas { width:100%; height:100%; }.actions { display:flex; gap:18rpx; margin-top:20rpx; }.actions button,.secondary { flex:1; height:82rpx; line-height:82rpx; margin:0; border-radius:12rpx; font-size:27rpx; color:#687586; background:#fff; }.actions button::after,.secondary::after { border:0; }.actions .primary { color:#fff; background:#b45b4e; }.secondary { width:100%; margin-top:16rpx; color:#b45b4e; background:#fff0eb; }
button { display:flex; align-items:center; justify-content:center; text-align:center; box-sizing:border-box; }
