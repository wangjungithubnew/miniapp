page { background:#f5f7fa; }.page { min-height:100vh; padding:24rpx; box-sizing:border-box; }.preview { height:500rpx; overflow:hidden; border-radius:18rpx; background:#fffaf0; box-shadow:0 2rpx 10rpx rgba(31,35,41,.05); }.canvas { width:100%; height:100%; }.panel { margin-top:20rpx; padding:26rpx; border-radius:18rpx; background:#fff; }.input { width:100%; height:150rpx; padding:20rpx; box-sizing:border-box; border:1rpx solid #e4e8ee; border-radius:12rpx; font-size:27rpx; }.label { display:block; margin-top:24rpx; color:#687586; font-size:23rpx; }.colors { display:flex; gap:18rpx; margin-top:14rpx; }.color { width:54rpx; height:54rpx; border-radius:50%; border:5rpx solid #fff; box-shadow:0 0 0 1rpx #d9dee6; }.color.selected { box-shadow:0 0 0 4rpx #c5cfdf; }.slider-row { display:flex; align-items:center; margin-top:18rpx; color:#687586; font-size:24rpx; }.slider-row text { width:100rpx; }.slider-row slider { flex:1; }.primary,.secondary { width:100%; height:82rpx; line-height:82rpx; margin-top:24rpx; border-radius:12rpx; font-size:27rpx; }.primary { color:#fff; background:#d95778; }.secondary { margin-top:16rpx; color:#d95778; background:#fff0f4; }.primary::after,.secondary::after { border:0; }
button { display:flex; align-items:center; justify-content:center; text-align:center; box-sizing:border-box; }
