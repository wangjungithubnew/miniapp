.group { margin: 36rpx 26rpx 0; }
.group-heading { display: flex; align-items: center; margin-bottom: 22rpx; }
.group-title { color: #20242b; font-size: 39rpx; font-weight: 500; }
.heading-line { width: 9rpx; height: 36rpx; background: #2878e5; border-radius: 8rpx; margin-right: 16rpx; order: -1; }
.grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28rpx 18rpx; }
