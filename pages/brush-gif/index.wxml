<view class="page"><view class="preview"><canvas type="2d" id="brushCanvas" class="canvas" disable-scroll="true" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd"></canvas><text wx:if="{{!hasDrawing}}" class="hint">在画布上绘制动态笔画</text></view><view class="panel"><text class="label">画笔颜色</text><view class="colors"><view wx:for="{{['#D95778','#17202C','#16835E','#4C68D7']}}" wx:key="*this" class="color {{color === item ? 'selected' : ''}}" style="background:{{item}}" data-color="{{item}}" bindtap="chooseColor"></view></view><view class="size-row"><text>笔刷粗细</text><slider min="3" max="24" step="1" value="{{width}}" bindchange="changeWidth" show-value /></view><view class="actions"><button class="play" bindtap="togglePlay">{{playing ? '暂停回放' : '播放笔画'}}</button><button bindtap="reset">清空</button></view><button class="primary" bindtap="save">保存当前画面</button><button class="secondary" wx:if="{{savedPath}}" bindtap="saveAlbum">保存到相册</button><text class="note">当前版本支持动态笔画回放；小程序前端暂不直接编码 GIF 文件。</text></view></view>
