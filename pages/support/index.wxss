page { background:#f5f7fa; }.page { min-height:100vh; padding:28rpx; box-sizing:border-box; }.card { padding:48rpx 30rpx 34rpx; border-radius:18rpx; background:#fff; text-align:center; box-shadow:0 2rpx 12rpx rgba(31,35,41,.05); }.heart { color:#20B8AA; font-size:86rpx; line-height:1; }.title { display:block; margin-top:18rpx; color:#263238; font-size:36rpx; font-weight:600; }.desc { display:block; margin:18rpx auto 36rpx; max-width:560rpx; color:#687586; font-size:25rpx; line-height:1.65; }.label { display:block; color:#526174; text-align:left; font-size:24rpx; }.amounts { display:grid; grid-template-columns:repeat(4,1fr); gap:14rpx; margin-top:16rpx; }.amount { height:74rpx; line-height:74rpx; border-radius:10rpx; color:#526174; background:#f3f5f7; font-size:25rpx; }.amount.selected { color:#fff; background:#20B8AA; }.pay-btn { width:100%; height:84rpx; line-height:84rpx; margin-top:32rpx; border-radius:10rpx; color:#fff; background:#20B8AA; font-size:28rpx; }.pay-btn::after { border:0; }.notice { display:block; margin-top:18rpx; color:#9aa4b0; font-size:21rpx; }
/* 金额选项和支付按钮统一居中。 */
.amount, .pay-btn { display:flex; align-items:center; justify-content:center; text-align:center; box-sizing:border-box; }
