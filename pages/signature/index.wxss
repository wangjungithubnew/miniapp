page { height: 100%; background: #f4f6f9; }
.signature-page { width: 100vw; height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: #f4f6f9; }
.board { position: relative; flex: 1; min-height: 0; margin: 22rpx 20rpx 12rpx; border-radius: 20rpx; overflow: hidden; background-color: #fff; }
.board.small-grid { background-image: linear-gradient(rgba(67,124,191,.18) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(67,124,191,.18) 1rpx, transparent 1rpx); background-size: 25% 25%; background-position: center center; }
.board.cross-grid { background-image: linear-gradient(rgba(67,124,191,.18) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(67,124,191,.18) 1rpx, transparent 1rpx), linear-gradient(45deg, transparent 49.7%, rgba(67,124,191,.16) 50%, transparent 50.3%), linear-gradient(-45deg, transparent 49.7%, rgba(67,124,191,.16) 50%, transparent 50.3%); background-size: 25% 25%,25% 25%,100% 100%,100% 100%; }
.board.no-grid { background-image: none; }
.sign-canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; }
.empty-hint { position: absolute; z-index: 0; left: 0; right: 0; top: 50%; text-align: center; color: rgba(95,112,132,.42); font-size: 29rpx; transform: translateY(-50%); pointer-events: none; }
.toolbar { height: calc(142rpx + env(safe-area-inset-bottom)); box-sizing: border-box; flex-shrink: 0; display: flex; align-items: center; padding: 10rpx 14rpx calc(14rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -5rpx 24rpx rgba(32,55,82,.08); }
.back-action { width: 94rpx; flex-shrink: 0; height: 84rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #526174; font-size: 22rpx; }
.back-arrow { font-size: 52rpx; line-height: 44rpx; font-weight: 300; }
.tools { display: flex; flex: 1; height: 100%; align-items: center; justify-content: space-around; min-width: 0; }
.tool { min-width: 62rpx; height: 86rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #354458; }
.share-tool { padding: 0; margin: 0; border-radius: 0; background: transparent; line-height: normal; }
.share-tool::after { border: 0; }
.tool-icon { height: 45rpx; line-height: 43rpx; font-size: 37rpx; font-weight: 400; }
.tool-label { white-space: nowrap; font-size: 19rpx; line-height: 28rpx; }
.tool.disabled { opacity: .34; }
.tool-divider { width: 1rpx; height: 52rpx; background: #dce2ea; margin: 0 4rpx; flex-shrink: 0; }
.tool.use-tool { color: #2878e5; }
.tool.use-tool .tool-icon { width: 46rpx; height: 46rpx; border-radius: 50%; background: #2878e5; color: #fff; line-height: 46rpx; text-align: center; font-size: 28rpx; }
.preview-mode .board { margin: 0; border-radius: 0; }
.preview-mode .board { background-image: none !important; }
.preview-close { position: absolute; z-index: 4; top: calc(26rpx + env(safe-area-inset-top)); left: 26rpx; padding: 14rpx 24rpx; border-radius: 30rpx; color: #fff; background: rgba(20,31,45,.65); font-size: 24rpx; }
.preview-toolbar { position: absolute; z-index: 4; left: 0; right: 0; bottom: 0; height: calc(100rpx + env(safe-area-inset-bottom)); padding: 0 30rpx env(safe-area-inset-bottom); display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,.96); color: #697586; font-size: 24rpx; }
.preview-share { margin: 0; padding: 0 30rpx; height: 64rpx; line-height: 64rpx; background: #2878e5; color: #fff; border-radius: 32rpx; font-size: 24rpx; }
.preview-share::after { border: 0; }
.share-mask { position: fixed; z-index: 20; inset: 0; background: rgba(13,23,37,.42); display: flex; align-items: flex-end; }
.share-panel { width: 100%; padding: 28rpx 26rpx calc(28rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 28rpx 28rpx 0 0; background: #fff; }
.share-heading { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 8rpx 28rpx; color: #263448; font-size: 31rpx; font-weight: 600; }
.share-close { font-size: 46rpx; font-weight: 300; color: #8994a3; padding: 0 8rpx; }
.share-grid { display: flex; flex-wrap: wrap; }
.share-item { width: 20%; display: flex; flex-direction: column; align-items: center; padding: 12rpx 0 22rpx; }
.share-logo { width: 84rpx; height: 84rpx; display: flex; align-items: center; justify-content: center; border-radius: 25rpx; background: #edf5ff; color: #2878e5; font-size: 44rpx; font-weight: 500; }
.logo-timeline { background: #eaf8ee; color: #39a86b; }.logo-favorite { background: #fff6e8; color: #e7a333; }.logo-save { background: #eef1f5; color: #586578; }.logo-sticker { background: #f3edff; color: #8257c5; }
.share-text { margin-top: 12rpx; color: #48566a; font-size: 21rpx; white-space: nowrap; }
