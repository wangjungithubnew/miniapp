.group { margin: 28rpx 28rpx 0; }
.group-heading { display: flex; align-items: center; margin-bottom: 22rpx; }
.group-title { color: #1F2329; font-size: 34rpx; font-weight: 500; }
.heading-line { width: 4rpx; height: 30rpx; background: #D95778; border-radius: 3rpx; margin-right: 16rpx; order: -1; }
.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
