page { background:#f5f7fa; }.page { min-height:100vh; padding:32rpx 28rpx; box-sizing:border-box; }.card { padding:44rpx 30rpx; border-radius:16rpx; background:#fff; text-align:center; }.title { display:block; color:#263238; font-size:32rpx; font-weight:600; }.desc { display:block; margin-top:14rpx; color:#687586; font-size:24rpx; }.code-box { height:500rpx; margin:30rpx auto; display:flex; align-items:center; justify-content:center; color:#87929e; font-size:24rpx; }.code-box image { width:440rpx; height:440rpx; }.save-btn { height:84rpx; display:flex; align-items:center; justify-content:center; color:#fff; background:#20B8AA; font-size:28rpx; }.save-btn[disabled] { background:#c8d1d1; }
