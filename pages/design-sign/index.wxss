page { background:#f5f7fa; }.page { min-height:100vh; padding:24rpx; box-sizing:border-box; }.preview { height:430rpx; position:relative; overflow:hidden; border-radius:18rpx; background:#fff; box-shadow:0 2rpx 10rpx rgba(31,35,41,.05); }.canvas { width:100%; height:100%; }.hint { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:#a1aab6; font-size:27rpx; pointer-events:none; }.panel { margin-top:20rpx; padding:26rpx; border-radius:18rpx; background:#fff; }.input { height:84rpx; padding:0 22rpx; box-sizing:border-box; border:1rpx solid #e4e8ee; border-radius:12rpx; font-size:28rpx; }.label { display:block; margin-top:24rpx; color:#687586; font-size:23rpx; }.styles,.colors { display:flex; gap:16rpx; margin-top:14rpx; }.style { padding:15rpx 24rpx; border-radius:12rpx; color:#687586; background:#f3f5f7; font-size:24rpx; }.style.selected { color:#d95778; background:#fff0f4; }.color { width:52rpx; height:52rpx; border-radius:50%; border:5rpx solid #fff; box-shadow:0 0 0 1rpx #d9dee6; }.color.selected { box-shadow:0 0 0 4rpx #f2b4c2; }.size-row { display:flex; align-items:center; margin:20rpx 0; color:#687586; font-size:24rpx; }.size-row slider { flex:1; margin-left:20rpx; }.primary,.secondary { width:100%; height:82rpx; line-height:82rpx; border-radius:12rpx; font-size:27rpx; }.primary { color:#fff; background:#d95778; }.secondary { margin-top:16rpx; color:#d95778; background:#fff0f4; }.primary::after,.secondary::after { border:0; }
button { display:flex; align-items:center; justify-content:center; text-align:center; box-sizing:border-box; }
