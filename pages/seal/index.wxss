page { background:#f5f7fa; }.page { min-height:100vh; padding:24rpx; box-sizing:border-box; }.preview { height:480rpx; display:flex; align-items:center; justify-content:center; overflow:hidden; border-radius:18rpx; background:#fff; box-shadow:0 2rpx 10rpx rgba(31,35,41,.05); }.canvas { width:100%; height:100%; }.panel { margin-top:20rpx; padding:26rpx; border-radius:18rpx; background:#fff; }.input { height:82rpx; margin-top:14rpx; padding:0 22rpx; box-sizing:border-box; border:1rpx solid #e4e8ee; border-radius:12rpx; font-size:27rpx; }.label { display:block; margin-top:24rpx; color:#687586; font-size:23rpx; }.options,.colors { display:flex; gap:16rpx; margin-top:14rpx; }.option { padding:15rpx 30rpx; border-radius:12rpx; color:#687586; background:#f3f5f7; font-size:24rpx; }.option.selected { color:#c83b4b; background:#fff0f1; }.color { width:52rpx; height:52rpx; border-radius:50%; border:5rpx solid #fff; box-shadow:0 0 0 1rpx #d9dee6; }.color.selected { box-shadow:0 0 0 4rpx #edadb5; }.size-row { display:flex; align-items:center; margin:20rpx 0; color:#687586; font-size:24rpx; }.size-row slider { flex:1; margin-left:20rpx; }.primary,.secondary { width:100%; height:82rpx; line-height:82rpx; border-radius:12rpx; font-size:27rpx; }.primary { color:#fff; background:#c83b4b; }.secondary { margin-top:16rpx; color:#c83b4b; background:#fff0f1; }.primary::after,.secondary::after { border:0; }
button { display:flex; align-items:center; justify-content:center; text-align:center; box-sizing:border-box; }
