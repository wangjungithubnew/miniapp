<view class="page"><view class="preview"><canvas type="2d" id="sealCanvas" class="canvas"></canvas></view><view class="panel"><input class="input" maxlength="8" data-field="text" bindinput="onInput" placeholder="输入印章主文字" value="{{text}}"/><input class="input" maxlength="16" data-field="subText" bindinput="onInput" placeholder="副文字（可选）" value="{{subText}}"/><text class="label">印章形状</text><view class="options"><view class="option {{shape === 'circle' ? 'selected' : ''}}" data-shape="circle" bindtap="chooseShape">圆章</view><view class="option {{shape === 'square' ? 'selected' : ''}}" data-shape="square" bindtap="chooseShape">方章</view></view><text class="label">印章颜色</text><view class="colors"><view wx:for="{{['#C83B4B','#17202C','#1C7C65','#3158A6']}}" wx:key="*this" class="color {{color === item ? 'selected' : ''}}" style="background:{{item}}" data-color="{{item}}" bindtap="chooseColor"></view></view><view class="size-row"><text>大小</text><slider min="180" max="320" step="10" value="{{size}}" bindchange="changeSize" show-value /></view><button class="primary" bindtap="save">保存印章</button><button class="secondary" wx:if="{{savedPath}}" bindtap="saveAlbum">保存到相册</button></view></view>
