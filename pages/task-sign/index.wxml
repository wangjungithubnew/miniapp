<view class="page">
  <block wx:if="{{sharedTask}}"><view class="hero"><view><text class="hero-title">{{sharedTask.title}}</text><text class="hero-desc">{{sharedTask.description || '请确认参与并完成签名'}}</text></view></view><view class="shared-card"><view class="progress-row"><text>已签 {{signatures.length}} 人</text><text>成员签名接龙</text></view><view wx:if="{{sharedTask.participants.length}}" class="preset">预设成员：{{sharedTask.participants.join('、')}}</view><view class="member-list"><view wx:for="{{signatures}}" wx:key="_id" class="member"><text class="member-dot done">✓</text><text>{{item.displayName}}</text></view><view wx:if="{{!signatures.length}}" class="no-sign">暂时还没有成员签名</view></view><button class="sign-btn" bindtap="openSign">我要签名</button><button class="share-btn" open-type="share">分享给成员</button></view></block>
  <block wx:else><view class="hero"><view><text class="hero-title">任务签名</text><text class="hero-desc">创建任务并分享给微信成员签名确认</text></view><button class="create-btn" bindtap="openCreate">新建任务</button></view><view wx:if="{{!tasks.length}}" class="empty"><text class="empty-icon">☷</text><text class="empty-title">还没有创建任务</text><text class="empty-desc">创建后分享给微信好友或群成员</text></view><scroll-view wx:else scroll-y class="task-list"><view wx:for="{{tasks}}" wx:key="id" class="task-card" bindtap="openTask" data-id="{{item.id}}"><view class="task-head"><view><text class="task-title">{{item.title}}</text><text class="task-time">点击查看与分享</text></view><text class="delete" catchtap="deleteTask" data-id="{{item.id}}">删除</text></view><text wx:if="{{item.description}}" class="task-desc">{{item.description}}</text></view></scroll-view></block>
  <view wx:if="{{createVisible}}" class="mask" bindtap="closeCreate"><view class="sheet" catchtap="noop"><text class="sheet-title">新建任务</text><input class="input" data-field="titleInput" bindinput="onInput" placeholder="任务名称，例如：活动报名确认" value="{{titleInput}}"/><textarea class="textarea" data-field="descriptionInput" bindinput="onInput" placeholder="任务说明（可选）" value="{{descriptionInput}}"/><textarea class="textarea" data-field="participantInput" bindinput="onInput" placeholder="预设成员姓名（可选，用逗号或换行分隔）" value="{{participantInput}}"/><view class="sheet-actions"><button bindtap="closeCreate">取消</button><button class="primary" bindtap="createTask">创建并分享</button></view></view></view>
  <view wx:if="{{signVisible}}" class="mask" bindtap="closeSign"><view class="sheet" catchtap="noop"><text class="sheet-title">任务签名</text><text class="sign-tip">填写您希望显示的姓名；系统会用微信身份防止重复签名。</text><input class="input" data-field="signerName" bindinput="onInput" placeholder="请输入您的姓名" value="{{signerName}}"/><view class="sheet-actions"><button bindtap="closeSign">取消</button><button class="primary" bindtap="confirmSign">确认签名</button></view></view></view>
</view>
