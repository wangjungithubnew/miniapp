<view class="page"><view class="hero"><view><text class="hero-title">定时消息</text><text class="hero-desc">先安排内容，到时间后打开页面即可复制发送</text></view><button class="create-btn" bindtap="openCreate">新建消息</button></view><view wx:if="{{!messages.length}}" class="empty"><text class="empty-icon">◷</text><text class="empty-title">还没有定时消息</text><text class="empty-desc">创建一条消息计划，管理你的待发送内容</text></view><scroll-view wx:else scroll-y class="message-list"><view wx:for="{{messages}}" wx:key="id" class="message-card"><view class="message-head"><text class="message-time">{{item.displayTime}}</text><text class="status {{item.status === '已到时间' ? 'ready' : ''}}">{{item.status}}</text></view><text class="message-content">{{item.content}}</text><view class="message-actions"><button bindtap="copy" data-content="{{item.content}}">复制消息</button><button class="delete" bindtap="remove" data-id="{{item.id}}">删除</button></view></view></scroll-view><view wx:if="{{createVisible}}" class="mask" bindtap="closeCreate"><view class="sheet" catchtap="noop"><text class="sheet-title">新建定时消息</text><textarea class="textarea" maxlength="500" placeholder="输入要发送的消息" value="{{content}}" bindinput="onInput"/><text class="label">发送日期</text><picker mode="date" start="{{minDate}}" value="{{sendAt.split('T')[0]}}" bindchange="onDateChange"><view class="picker">{{sendAt.split('T')[0]}}</view></picker><text class="label">发送时间</text><picker mode="time" value="{{sendAt.split('T')[1]}}" bindchange="onTimeChange"><view class="picker">{{sendAt.split('T')[1]}}</view></picker><view class="sheet-actions"><button bindtap="closeCreate">取消</button><button class="primary" bindtap="create">保存计划</button></view></view></view></view>
