<view class="page"><view class="preview"><canvas type="2d" id="designCanvas" class="canvas"></canvas><text wx:if="{{!text}}" class="hint">输入文字后生成签名</text></view><view class="panel"><input class="input" maxlength="24" placeholder="输入姓名或签名文字" value="{{text}}" bindinput="onInput"/><text class="label">风格</text><view class="styles"><view wx:for="{{styles}}" wx:key="*this" class="style {{styleIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="chooseStyle">{{item}}</view></view><text class="label">颜色</text><view class="colors"><view wx:for="{{colors}}" wx:key="*this" class="color {{color === item ? 'selected' : ''}}" style="background:{{item}}" data-color="{{item}}" bindtap="chooseColor"></view></view><view class="size-row"><text>大小</text><slider min="40" max="100" step="2" value="{{size}}" bindchange="changeSize" show-value /></view><button class="primary" bindtap="save">保存设计签名</button><button class="secondary" wx:if="{{savedPath}}" bindtap="saveAlbum">保存到相册</button></view></view>
