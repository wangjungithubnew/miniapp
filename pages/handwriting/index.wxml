<view class="page"><view class="preview"><canvas type="2d" id="handwritingCanvas" class="canvas"></canvas></view><view class="panel"><textarea class="input" maxlength="120" placeholder="输入要生成的文字" value="{{text}}" bindinput="onInput"/><text class="label">文字颜色</text><view class="colors"><view wx:for="{{['#263448','#D95778','#16835E','#4C68D7']}}" wx:key="*this" class="color {{color === item ? 'selected' : ''}}" style="background:{{item}}" data-color="{{item}}" bindtap="chooseColor"></view></view><view class="slider-row"><text>字号</text><slider min="28" max="60" value="{{size}}" data-field="size" bindchange="change" show-value /></view><view class="slider-row"><text>字距</text><slider min="0" max="24" value="{{spacing}}" data-field="spacing" bindchange="change" show-value /></view><view class="slider-row"><text>自然度</text><slider min="0" max="10" value="{{natural}}" data-field="natural" bindchange="change" show-value /></view><button class="primary" bindtap="save">保存手写效果</button><button class="secondary" wx:if="{{savedPath}}" bindtap="saveAlbum">保存到相册</button></view></view>
