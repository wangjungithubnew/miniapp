<view class="page"><view class="tip">选择一个汉字，在米字格中跟随淡色字帖临摹</view><scroll-view scroll-x class="char-list"><view wx:for="{{chars}}" wx:key="*this" class="char {{selected === item ? 'selected' : ''}}" data-char="{{item}}" bindtap="chooseChar">{{item}}</view></scroll-view><view class="board"><canvas type="2d" id="copyCanvas" class="canvas" disable-scroll="true" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd"></canvas></view><view class="actions"><button bindtap="clear">清空重写</button><button class="primary" bindtap="save">保存练习</button></view><button wx:if="{{savedPath}}" class="secondary" bindtap="saveAlbum">保存到相册</button></view>
